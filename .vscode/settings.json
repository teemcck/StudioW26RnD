{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.idea": true,
        "**/.vs": true,
        "**/*.meta": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        ".ai": true,
        "[Bb]uild": true,
        "[Bb]uilds": true,
        "[Ll]ibrary": true,
        "[Ll]ogs": true,
        "[Oo]bj": true,
        "[Tt]emp": true,
        "[Tt]emp *": true,
        "UserSettings": true
    },
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml"
    },
    "search.exclude": {
        "**/.idea/**": true,
        "**/[Ll]ibrary/**": true,
        "**/[Ll]ogs/**": true,
        "**/[Tt]emp/**": true,
        "**/[Tt]emp */**": true,
        "**/[Oo]bj/**": true
    },
    "explorer.sortOrder": "foldersNestsFiles",
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj",
        "*.slnx": "*.csproj",
        "WormBossController.cs": "WormBossController.*.cs"
    },
    "dotnet.defaultSolution": "StudioW26RnD.slnx",
    "dotnet.enableWorkspaceBasedDevelopment": false
}
